{
  "name": "@genesis/tool-gateway",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@genesis/domain": "workspace:*",
    "@genesis/mycelium-contracts": "workspace:*",
    "@genesis/policy-engine": "workspace:*",
    "@genesis/tool-sdk": "workspace:*"
  },
  "devDependencies": {
    "@genesis/test-kit": "workspace:*",
    "vitest": "^2.1.8"
  }
}
